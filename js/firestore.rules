rules_version = '2';
// Nguyên tắc: client chỉ ĐỌC dữ liệu của chính mình + danh mục/học liệu đã xuất bản.
// MỌI thao tác ghi quan trọng đi qua Cloud Functions (Admin SDK bỏ qua rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole() { return request.auth != null && request.auth.token.role in ['STUDENT', 'TEACHER', 'ADMIN']; }
    function isAdmin() { return hasRole() && request.auth.token.role == 'ADMIN'; }
    function isOwner(uid) { return hasRole() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /bookmarks/{id}     { allow read: if isOwner(uid); allow write: if false; }
      match /viewState/{id}     { allow read, write: if false; }
      match /viewHistory/{id}   { allow read: if isOwner(uid); allow delete: if isOwner(uid); allow create, update: if false; }
      match /searchHistory/{id} { allow read: if isOwner(uid); allow delete: if isOwner(uid); allow create, update: if false; }
      match /notifications/{id} {
        allow read: if isOwner(uid);
        // Chỉ được đổi cờ isRead, không sửa nội dung thông báo
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow create, delete: if false;
      }
    }

    // Danh mục: học sinh chỉ thấy mục ACTIVE
    match /{catalog}/{id} {
      allow read: if hasRole() && catalog in ['subjects', 'grades', 'topics', 'resourceTypes'] && (resource.data.status == 'ACTIVE' || isAdmin());
      allow write: if false;
    }
    match /settings/{id} { allow read: if hasRole(); allow write: if false; }

    // Học liệu: học sinh chỉ đọc được bản PUBLISHED và chưa xóa. Đường dẫn file nằm ở subcollection `files` (chỉ admin).
    match /resources/{rid} {
      allow read: if hasRole() && ((resource.data.status == 'PUBLISHED' && resource.data.deleted == false) || isAdmin());
      allow write: if false;
      match /files/{fid}         { allow read: if isAdmin(); allow write: if false; }
      match /statusHistory/{id}  { allow read: if isAdmin(); allow write: if false; }
      match /reviews/{id}        { allow read: if isAdmin(); allow write: if false; }
    }

    // audit_logs, download_history, stats_daily, resource_requests (yêu cầu tài liệu)...: chỉ Cloud Functions truy cập
    match /{document=**} { allow read, write: if false; }
  }
}
